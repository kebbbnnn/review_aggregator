# Data Sources
TMDB_API_KEY=your_tmdb_api_key
OMDB_API_KEY=your_omdb_api_key

# Reddit API
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=MovieReviewAggregator/1.0

# LLM Integration (OpenAI Compatible)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=your_llm_api_key
LLM_MODEL=gemini-2.5-flash

# Cloudflare D1 Database (DB1: Metadata & Catalog)
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_D1_DATABASE_ID=your_d1_database_uuid
CF_API_TOKEN=your_cloudflare_api_token

# Cloudflare D1 Database (DB2: LLM Summaries)
CF_SUMMARY_ACCOUNT_ID=your_summary_account_id
CF_SUMMARY_DATABASE_ID=your_summary_d1_database_uuid
CF_SUMMARY_API_TOKEN=your_summary_api_token

# Summary Worker & Auth (for Primary Worker)
SUMMARY_WORKER_URL=https://movie-summaries-api.your-account.workers.dev
SUMMARY_API_KEY=your_shared_secret_key

# Tuning
MAX_MOVIES_PER_SYNC=10
MIN_POPULARITY=20.0
RECENT_MONTHS=6

